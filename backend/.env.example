# SECRET_KEY: generá uno con `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=

# En desarrollo: True. En producción: False
DEBUG=False

# Entorno: production | staging | (vacio para dev local)
# Se usa para detectar si el DATABASE_URL apunta a la DB equivocada.
# En Render: el servicio production debe tener ENVIRONMENT=production,
#            el servicio staging debe tener ENVIRONMENT=staging.
ENVIRONMENT=

# Origen permitido del frontend (CORS). En desarrollo: http://localhost:5173
FRONTEND_URL=https://gim-saas.onrender.com
# Alternativa: lista separada por comas que tiene prioridad sobre FRONTEND_URL
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://otro.com

# URL completa de la base PostgreSQL (dj-database-url)
# - Producción: branch `production` de Neon (endpoint con -pooler)
# - Staging: branch `staging` de Neon (clon de producción, endpoint con -pooler)
# - Local: tu branch de trabajo o el `neondb` default
# IMPORTANTE: si staging usa el mismo DATABASE_URL que producción, ambos
# entornos escriben en la misma base (los cambios de staging "aparecen" en
# producción). Verificá en Render que cada servicio use su branch propia.
DATABASE_URL=

# Verificación: copiá los DATABASE_URL de cada servicio de Render y compará.
# Te dejan un mecanismo de chequeo en código:
#   python manage.py check_environment

# Cloudinary (fotos/logos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Tareas programadas (renovaciones automáticas + cambios de plan)
# ------------------------------------------------------------------
# API key compartida para el endpoint /api/system/tasks/ (GitHub Actions).
# Misma value que el secret SCHEDULED_TASKS_KEY del workflow.
SCHEDULED_TASKS_KEY=

# Intervalo mínimo entre corridas del mantenimiento (segundos).
# Default 21600 = 6 hs. Con 43200 (12 hs) alcanza para un gimnasio chico.
# SCHEDULED_TASKS_INTERVAL_SECONDS=21600

# Disparador perezoso desde requests. Default true.
# SCHEDULED_TASKS_ENABLED=true

# ------------------------------------------------------------------
# Resend (emails transaccionales: password reset)
# ------------------------------------------------------------------
# API key de Resend (https://resend.com). Tier free: 3,000 emails/mes.
RESEND_API_KEY=

# Remitente de los emails. En Resend hay que verificar el dominio primero.
# Por defecto funciona con el dominio de prueba de Resend.
# DEFAULT_FROM_EMAIL=Gim-SaaS <onboarding@resend.dev>

# Tiempo de vida de los tokens de reseteo (segundos). Default 3600 (1 hora).
# PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# ------------------------------------------------------------------
# Seguridad (Fase 3 — Endurecimiento)
# ------------------------------------------------------------------
# Cooldown por cuenta entre solicitudes de reseteo de contraseña (segundos).
# Complementa el throttle por IP contra email-bombing. Default 60.
# PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60

# Bloqueo de login por fuerza bruta / credential stuffing (django-axes).
# Cantidad de fallos antes del lockout. Default 5 (cooloff: 15 minutos).
# AXES_FAILURE_LIMIT=5

# TTL del token de acceso del portal del socio (días). Al vencerse, leer
# los datos del socio rota el token y lo devuelve en la respuesta.
# MEMBER_ACCESS_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------------
# Throttling (rate limiting de la API)
# ------------------------------------------------------------------
# Cantidad de proxies entre el cliente y Django. Define cómo se resuelve
# la IP real del cliente para los throttles por IP:
# - 0: la IP de conexión directa (correcto en desarrollo local).
# - 1: la última IP de X-Forwarded-For (Render va detrás de un proxy;
#      con 0 todos los clientes compartirían el bucket del proxy).
# NUM_PROXIES=1

# Los rates globales (anon: 60/hour, user: 1000/hour) y los scopes por
# endpoint (login, onboarding_*, password_reset_*, member_portal_token,
# member_uploads, system_admin, user_heavy) están fijados en
# config/settings.py y config/api/throttles.py; no se configuran por
# variable de entorno.