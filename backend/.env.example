# SECRET_KEY: generá uno con `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=

# En desarrollo: True. En producción: False
DEBUG=False

# Entorno: production | staging | (vacio para dev local)
# Se usa para detectar si el DATABASE_URL apunta a la DB equivocada.
# En Render: el servicio production debe tener ENVIRONMENT=production,
#            el servicio staging debe tener ENVIRONMENT=staging.
ENVIRONMENT=

# Origen permitido del frontend (CORS). En desarrollo: http://localhost:5173
FRONTEND_URL=https://gim-saas.onrender.com
# Alternativa: lista separada por comas que tiene prioridad sobre FRONTEND_URL
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://otro.com

# URL completa de la base PostgreSQL (dj-database-url)
# - Producción: branch `production` de Neon (endpoint con -pooler)
# - Staging: branch `staging` de Neon (clon de producción, endpoint con -pooler)
# - Local: tu branch de trabajo o el `neondb` default
# IMPORTANTE: si staging usa el mismo DATABASE_URL que producción, ambos
# entornos escriben en la misma base (los cambios de staging "aparecen" en
# producción). Verificá en Render que cada servicio use su branch propia.
DATABASE_URL=

# Verificación: copiá los DATABASE_URL de cada servicio de Render y compará.
# Te dejan un mecanismo de chequeo en código:
#   python manage.py check_environment

# Cloudinary (fotos/logos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Tareas programadas (renovaciones automáticas + cambios de plan)
# ------------------------------------------------------------------
# API key compartida para el endpoint /api/system/tasks/ (GitHub Actions).
# Misma value que el secret SCHEDULED_TASKS_KEY del workflow.
SCHEDULED_TASKS_KEY=

# Intervalo mínimo entre corridas del mantenimiento (segundos).
# Default 21600 = 6 hs. Con 43200 (12 hs) alcanza para un gimnasio chico.
# SCHEDULED_TASKS_INTERVAL_SECONDS=21600

# Disparador perezoso desde requests. Default true.
# SCHEDULED_TASKS_ENABLED=true